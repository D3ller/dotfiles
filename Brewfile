# Install CLI Tools
brew "node" # Node.js runtime
brew "nvm" # Node version manager
brew "git" # Version control
brew "tree" # List files as a tree
brew "wget" # Download files from the CLI
brew "mole" # Clean your mac but free.
brew "gh" # Github cli
brew "cmake" # Build C and C++
brew "gradle" # Java build automation
brew "nano" # To replace the nano command from macOs
brew "lua" # Install lua programming language