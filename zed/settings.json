{
  "debugger": {
    "dock": "right"
  },
  "title_bar": {
    "show_sign_in": false
  },
  "use_display_p3": false,
  "agent": {
    "max_content_width": 0.0,
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
